rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
    }
    match /uploads/{ownerId}/{allPaths=**} {
      function ownsPath() { return request.auth != null && request.auth.uid == ownerId; }
      function validMedia() {
        return request.resource != null && request.resource.size > 0 && request.resource.size < 50 * 1024 * 1024 &&
          (request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif|bmp)') ||
           request.resource.contentType.matches('video/.*') || request.resource.contentType.matches('audio/.*'));
      }
      allow create, update: if ownsPath() && validMedia();
      allow delete: if ownsPath();
    }
  }
}
